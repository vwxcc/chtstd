########################################
# ChatStudio — .env.example
# Скопируйте в .env и заполните реальными значениями.
########################################

# --- Сервер ---
PORT=8000
DATA_DIR=./data
UPLOAD_DIR=./uploads
FRONTEND_DIR=./frontend

# --- Сессии / безопасность ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=chatstudio_session
SESSION_MAX_AGE_DAYS=30

# На локальном HTTP (ZimaOS без TLS) — 0.
# При работе через HTTPS — обязательно 1.
SESSION_COOKIE_SECURE=1
CSRF_PROTECTION=1

# --- Rate limiting (раздел 4, 6) ---
AUTH_RATE_WINDOW=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5

# --- Ограничения ввода ---
MAX_NAME_LENGTH=80
MAX_PROMPT_LENGTH=30000
MAX_SEARCH_LENGTH=200

# --- Файлы (раздел 36, 38, 39) ---
MAX_FILE_SIZE=20971520
MAX_TOTAL_FILE_SIZE=52428800
MAX_FILES_PER_REQUEST=20
MAX_FILE_CONTEXT_CHARS=500000

MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNPACKED_SIZE=104857600

MAX_DOCUMENT_PAGES=500
MAX_SPREADSHEET_SHEETS=100
MAX_PRESENTATION_SLIDES=500

# --- AI / генерация (раздел 21, 31, 58) ---
REQUEST_TIMEOUT=300
CONNECTION_TIMEOUT=20
GLOBAL_AI_CONCURRENCY=3
AI_SEND_IMAGES=true

# --- Администраторы (раздел 32) ---
ADMIN_EMAILS=admin@example.com

# --- Провайдеры AI (пример; реальные ключи задаются под именами из providers.api_key_env) ---
QWEN_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
