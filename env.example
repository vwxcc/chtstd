# Required: token from @BotFather. Do not commit the real token.
TELEGRAM_BOT_TOKEN=

# Required for access: comma-separated numeric Telegram user IDs.
# Example: ALLOWED_USER_IDS=123456789
ALLOWED_USER_IDS=
# Optional trusted operators; these IDs are also allowed to submit code.
ADMIN_USER_IDS=

# One Python block executes at a time. New submissions wait in this queue.
MAX_QUEUE_SIZE=5
MAX_SUBMISSION_BYTES=900000
MAX_INPUT_FILE_BYTES=1000000
TASK_TIMEOUT_SECONDS=12
TASK_MEMORY_MB=256
INPUT_TIMEOUT_SECONDS=120
MAX_ARTIFACT_FILES=40
MAX_ARTIFACT_TOTAL_BYTES=41943040
MAX_ARTIFACT_FILE_BYTES=15728640
LOG_LEVEL=INFO
